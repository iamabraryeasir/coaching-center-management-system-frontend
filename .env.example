# ──────────────────────────────────────────────────────────
# REQUIRED — Core API & Application Configuration
# ──────────────────────────────────────────────────────────

# Backend REST API base URL (no trailing slash)
# Example: https://api.yourcoaching.com/api/v1
NEXT_PUBLIC_API_BASE_URL=""

# Canonical frontend URL — used for Stripe success/cancel return URLs
# Example: https://yourcoaching.com
NEXT_PUBLIC_APP_URL=""

# Google OAuth 2.0 Client ID (from Google Cloud Console → Credentials)
# Required for Google Sign-In button on the login and onboarding pages
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# ──────────────────────────────────────────────────────────
# OPTIONAL — White-Label Branding Overrides
# All have sensible defaults; only override for custom deployments
# ──────────────────────────────────────────────────────────

# Application display names
NEXT_PUBLIC_APP_NAME=""
NEXT_PUBLIC_APP_SHORT_NAME=""
NEXT_PUBLIC_APP_TAGLINE=""
NEXT_PUBLIC_APP_DESCRIPTION=""

# Branding assets
NEXT_PUBLIC_LOGO_URL=""

# Contact & location information
NEXT_PUBLIC_SUPPORT_EMAIL=""
NEXT_PUBLIC_SUPPORT_PHONE=""
NEXT_PUBLIC_CAMPUS_ADDRESS=""

# Academic & financial defaults
NEXT_PUBLIC_CURRENCY=""
NEXT_PUBLIC_ACADEMIC_YEAR=""